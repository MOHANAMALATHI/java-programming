import java.util.*;
public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int num = sc.nextInt();
      int digit1 = num / 100;
      int digit2 = (num / 10) % 10;
      int digit3 = num % 10;
      int reversed_num = (digit3 * 100) + (digit2 * 10) + digit1;
      if (num == reversed_num) {
        System.out.println("YES");
      } else {
        System.out.println("NO");
      }
      sc.close();
    }
}
      
